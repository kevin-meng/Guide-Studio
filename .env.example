# Copy to .env; NEVER commit real credentials.
DATABASE_URL=sqlite:///./data/guide-studio.db
SESSION_SECRET=replace-with-a-random-long-secret-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password-min-12-characters
PUBLIC_BASE_URL=http://localhost:8000
# local | cos
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
# COS uses its S3-compatible endpoint. Set private bucket/CORS; credentials remain server-side.
COS_BUCKET=
COS_REGION=ap-shanghai
COS_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
COS_ACCESS_KEY_ID=
COS_SECRET_ACCESS_KEY=
# Optional for temporary Tencent STS credentials
COS_SESSION_TOKEN=
